<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Creeper World 4 Archipelago mod. This is the plugin that ships in
       releases. Build prerequisites: src\GameDir.props pointing at a CW4
       install with BepInEx installed and launched once (generates the
       interop assemblies referenced below). The game must be CLOSED when
       building - the deploy step cannot overwrite a loaded DLL. -->

  <Import Project="..\GameDir.props" Condition="Exists('..\GameDir.props')" />

  <Target Name="EnsureGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)')"
           Text="GameDir is not set or does not exist. Copy src\GameDir.props.example to src\GameDir.props and point it at your Creeper World 4 install (with BepInEx installed and run once)." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CW4Archipelago</AssemblyName>
    <RootNamespace>CW4Archipelago</RootNamespace>
    <Version>0.1.6</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>annotations</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet dependency DLLs (Archipelago.MultiClient.Net and its
         dependencies) into the output so the release zip can include them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <ProjectReference Include="..\CW4Archipelago.Core\CW4Archipelago.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy to the game's plugin folder on build, in the same subfolder
       layout the release zip uses. -->
  <!-- Build with -p:SkipDeploy=true to compile WITHOUT installing into the
       game. Every build used to re-create the plugin folder, which quietly
       re-enabled this mod in the middle of a vanilla test session. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\CW4Archipelago" />
    <Message Importance="high" Text="Deployed CW4Archipelago to $(GameDir)\BepInEx\plugins\CW4Archipelago" />
  </Target>

</Project>
